# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/feedants
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS ("*" allows any origin; set explicit origins in production)
CORS_ORIGINS=*

# Localisation
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi

# Payments: "mock" for local development, "razorpay" once real keys are supplied
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Logging
LOG_LEVEL=debug
